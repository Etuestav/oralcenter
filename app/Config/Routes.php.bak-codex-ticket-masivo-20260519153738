$maintenanceRoutes = [
    'alergia'       => ['controller' => 'Alergia', 'json' => 'jsonAlergia'],
    'banco'         => ['controller' => 'Banco', 'json' => 'jsonBanco'],
    'categoria'     => ['controller' => 'Categoria', 'json' => 'jsonCategoria'],
    'citado'        => ['controller' => 'Citado', 'json' => 'jsonCitado'],
    'concepto'      => ['controller' => 'Concepto', 'json' => 'jsonConcepto'],
    'diagnostico'   => ['controller' => 'Diagnostico', 'json' => 'jsonDiagnostico'],
    'especialidad'  => ['controller' => 'Especialidad', 'json' => 'jsonEspecialidad'],
    'medida'        => ['controller' => 'Medida', 'json' => 'jsonMedida'],
    'moneda'        => ['controller' => 'Moneda', 'json' => 'jsonMoneda'],
    'pago'          => ['controller' => 'Pago', 'json' => 'jsonPago'],
    'tarjeta'       => ['controller' => 'Tarjeta', 'json' => 'jsonTarjeta'],
    'tipodocumento' => ['controller' => 'Tipodocumento', 'json' => 'jsonDocumento'],
];

foreach ($maintenanceRoutes as $segment => $config) {
    $controller = $config['controller'];
    $json = $config['json'];

    $routes->group($segment, static function (RouteCollection $routes) use ($controller, $json): void {
        $routes->get('/', "mantenimiento\\{$controller}::index");
        $routes->get('nuevo', "mantenimiento\\{$controller}::nuevo");
        $routes->post('guardar', "mantenimiento\\{$controller}::guardar");
        $routes->get('editar/(:any)', "mantenimiento\\{$controller}::editar/$1");
        $routes->post('update', "mantenimiento\\{$controller}::update");
        $routes->get('anular', "mantenimiento\\{$controller}::anular");
        $routes->get(strtolower($json), "mantenimiento\\{$controller}::{$json}");
        $routes->get($json, "mantenimiento\\{$controller}::{$json}");
    });
}

