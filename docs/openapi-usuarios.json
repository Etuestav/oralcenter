{
  "openapi": "3.0.3",
  "info": {
    "title": "OralCenter API - Usuarios",
    "version": "1.0.0",
    "description": "API REST para logueo de usuarios del sistema en app Android."
  },
  "servers": [
    {
      "url": "http://localhost/OralCenter/api",
      "description": "Servidor local WAMP"
    }
  ],
  "paths": {
    "/usuarios/login": {
      "post": {
        "summary": "Iniciar sesion de usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "admin",
                "password": "tu_clave",
                "device_name": "Android"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login correcto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales invalidas"
          },
          "422": {
            "description": "Datos incompletos"
          }
        }
      }
    },
    "/usuarios/me": {
      "get": {
        "summary": "Obtener usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token invalido o expirado"
          }
        }
      }
    },
    "/usuarios/logout": {
      "post": {
        "summary": "Cerrar sesion y revocar token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesion cerrada"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "tu_clave"
          },
          "device_name": {
            "type": "string",
            "example": "Samsung A54"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "example": "2026-06-16 10:00:00"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "admin"
          },
          "nombre": {
            "type": "string",
            "example": "Nacional Code"
          },
          "apellido": {
            "type": "string",
            "example": "Nacional Code"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "telefono": {
            "type": "string",
            "nullable": true
          },
          "documento": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string"
              },
              "numero": {
                "type": "string"
              }
            }
          },
          "rol": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nombre": {
                "type": "string"
              }
            }
          },
          "medico": {
            "nullable": true,
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "especialidad_id": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
